# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/retargeting_agent
REDIS_URL=redis://localhost:6379

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Email Channel (SendGrid)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=retarget@company.com
SENDGRID_FROM_NAME=Company Retargeting

# SMS Channel (Twilio)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# Facebook Ads Integration
FACEBOOK_ACCESS_TOKEN=xxx
FACEBOOK_PIXEL_ID=xxx
FACEBOOK_AD_ACCOUNT_ID=act_xxx

# Google Ads Integration
GOOGLE_ADS_CLIENT_ID=xxx
GOOGLE_ADS_CLIENT_SECRET=xxx
GOOGLE_ADS_REFRESH_TOKEN=xxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_CUSTOMER_ID=xxx

# LinkedIn Integration
LINKEDIN_ACCESS_TOKEN=xxx
LINKEDIN_ORG_ID=xxx

# Segment (Event Tracking)
SEGMENT_WRITE_KEY=xxx

# Operator Dashboard
DASHBOARD_SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Approval Settings
REQUIRE_APPROVAL_FOR_DISCOUNT_ABOVE_PERCENT=10
DEFAULT_MAX_DISCOUNT_PERCENT=15

# Retargeting Rules
RETARGET_TRIGGER_HOURS=2
HOT_LEAD_THRESHOLD=75
COLD_LEAD_THRESHOLD=40

# Webhooks
WEBHOOK_SIGNING_SECRET=xxx
SENDGRID_WEBHOOK_SECRET=xxx
TWILIO_WEBHOOK_SECRET=xxx

# Feature Flags
ENABLE_FACEBOOK_RETARGETING=true
ENABLE_GOOGLE_ADS_RETARGETING=true
ENABLE_LINKEDIN_RETARGETING=false
ENABLE_AUTO_APPROVAL=false

# Monitoring
DATADOG_API_KEY=xxx
SENTRY_DSN=xxx
