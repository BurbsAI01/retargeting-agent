# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/retargeting_agent
REDIS_URL=redis://localhost:6379

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Email Channel (Mailgun)
MAILGUN_API_KEY=mg-xxx
FROM_EMAIL=noreply@retargeting.app
FROM_NAME=Retargeting Team
REPLY_TO_EMAIL=support@retargeting.app
APP_URL=https://app.example.com

# SMS Channel (Twilio)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# Facebook Ads Integration
ENABLE_FACEBOOK_RETARGETING=false
FACEBOOK_ACCESS_TOKEN=xxx
FACEBOOK_PIXEL_ID=xxx
FACEBOOK_AUDIENCE_ID=xxx

# Google Ads Integration
ENABLE_GOOGLE_ADS_RETARGETING=false
GOOGLE_CONVERSION_ID=xxx
GOOGLE_CONVERSION_LABEL=xxx
GOOGLE_TRACKING_ID=xxx
GOOGLE_ADS_API_KEY=xxx
GOOGLE_ADS_CUSTOMER_ID=xxx

# LinkedIn Integration
ENABLE_LINKEDIN_RETARGETING=false
LINKEDIN_INSIGHT_TAG=xxx
LINKEDIN_ACCESS_TOKEN=xxx

# Approval Settings
REQUIRE_APPROVAL_FOR_DISCOUNT_ABOVE_PERCENT=10
DEFAULT_MAX_DISCOUNT_PERCENT=15

# Feature Flags
ENABLE_SMS_RETARGETING=true
ENABLE_AUTO_APPROVAL=false

# Job Queue Configuration
JOB_QUEUE_ATTEMPTS=3
JOB_QUEUE_BACKOFF_DELAY=2000
